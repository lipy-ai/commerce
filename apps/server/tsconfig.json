{
	"compilerOptions": {
		"target": "ESNext",
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"baseUrl": "./",
		"module": "ESNext",
		"strict": true,
		"strictNullChecks": true,

		"moduleResolution": "Bundler",
		"noImplicitAny": true,
		"removeComments": true,
		"allowImportingTsExtensions": false,
		"noEmit": false,

		"composite": true,
		"declaration": true, // optional, but useful
		"declarationMap": true, // optional
		"emitDeclarationOnly": true,

		"paths": {
			"@/*": ["./src/*"]
		},
		"typeRoots": ["./node_modules/@types"],
		"types": ["node"],
		"outDir": "./dist",
		"skipLibCheck": true
	},
	"include": ["src"], // adjust as needed
	"exclude": ["node_modules", "dist"],
	"tsc-alias": {
		"resolveFullPaths": true
	}
}
