	"scripts": {
		"build": "dotenv -- turbo run build",
		"start": "dotenv -- turbo run start",
		"dev": "dotenv -- turbo run dev",
		"docker-dev": "dotenv -- docker compose up -d && bun run dev",
		"lint": "turbo run lint",
		"format": "biome format \"**/*.{ts,tsx}\"  --write",
		"check-types": "turbo run check-types",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@types/bun": "latest",
		"dotenv-cli": "^8.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"turbo": "^2.5.4",
		"typescript": "5.8.2",
		"vite": "^6.3.5"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.2.18",
	"workspaces": ["apps/*", "packages/*"],
	"lockfileVersion": 0,
	"dependencies": {},
	"trustedDependencies": [
		"@biomejs/biome",
		"@parcel/watcher",
		"@tailwindcss/oxide",
		"core-js",
		"esbuild",
		"bun",
		"msw"
	],
	"module": "index.ts",
	"type": "module"
}
