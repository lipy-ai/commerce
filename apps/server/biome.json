{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*.ts",
			"**/src/**/*.tsx",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.js",
			"!**/*.css",
			"!**/*.json",
			"!**/dist/**/*"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useKeyWithClickEvents": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"complexity": {
				"noBannedTypes": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off",
				"noAssignInExpressions": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
