{
	"name": "@lipy/server",
	"types": "src/types/index.d.ts",
	"scripts": {
		"env": "dotenv -e ../../.env --",
		"start": "bun run env -- bun build/index.js",
		"dev": "bun run env bun run --hot src/index.ts",
		"build": "bun build src/index.ts --outdir ./build --target bun --minify --sourcemap=linked",
		"studio": "bun drizzle-kit studio --port 3001",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run db:generate && bun run env drizzle-kit migrate",
		"db:seed": "bun run env bun ./src/db/seed.ts",
		"format": "biome format",
		"lint": "tsc && biome lint",
		"check": "biome check"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.844.0",
		"@aws-sdk/client-ses": "^3.844.0",
		"@aws-sdk/client-sns": "^3.844.0",
		"@aws-sdk/s3-request-presigner": "^3.844.0",
		"@faker-js/faker": "^9.9.0",
		"@hono/event-emitter": "^2.0.0",
		"@hono/zod-validator": "^0.4.3",
		"better-auth": "^1.2.12",
		"bun": "^1.2.18",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.1",
		"dotenv-expand": "^12.0.2",
		"drizzle-orm": "^0.44.2",
		"fast-equals": "^5.2.2",
		"hono": "^4.8.5",
		"ioredis": "^5.6.1",
		"isbot": "^5.1.28",
		"kysely": "^0.27.6",
		"libphonenumber-js": "^1.12.9",
		"mailchecker": "^6.0.17",
		"minisearch": "^7.1.2",
		"nanoid": "^5.1.5",
		"pg": "^8.16.3",
		"pino": "^9.7.0",
		"pino-pretty": "^13.0.0",
		"posthog-node": "^5.6.0",
		"slugify": "^1.6.6",
		"validator": "^13.15.15",
		"zod": "^3.25.76"
	},
	"packageManager": "pnpm@9.1.1",
	"devDependencies": {
		"@types/bun": "^1.2.18",
		"@types/node": "^24.0.13",
		"@types/pg": "^8.15.4",
		"@types/validator": "^13.15.2",
		"drizzle-kit": "^0.30.6",
		"drizzle-seed": "^0.3.1"
	},
	"exports": {
		"./types/*": "./src/types/*"
	}
}
